{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:sidecar": "go build -o workspace-sidecar ./cmd/workspace-sidecar",
    "build:sidecar:mac": "mkdir -p build/sidecar/darwin-arm64 && GOOS=darwin GOARCH=arm64 go build -o build/sidecar/darwin-arm64/workspace-sidecar ./cmd/workspace-sidecar",
    "build:sidecar:win": "mkdir -p build/sidecar/win32-x64 && GOOS=windows GOARCH=amd64 go build -o build/sidecar/win32-x64/workspace-sidecar.exe ./cmd/workspace-sidecar",
    "build:sidecars": "npm run build:sidecar:mac && npm run build:sidecar:win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2"
  }
}
