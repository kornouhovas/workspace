{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:version": "node scripts/write-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "build:renderer": "vite build",
    "build:desktop": "esbuild src/desktop/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/desktop/main.cjs && esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/desktop/preload.cjs && esbuild src/desktop/backend-controller.ts --bundle --platform=node --format=esm --outfile=dist/desktop/backend-controller.mjs",
    "build:service-test-lib": "esbuild src/service/settings.ts --bundle --platform=node --format=esm --external:better-sqlite3 --outfile=dist/service/settings.mjs",
    "build:backend": "esbuild src/service/entry.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=dist/service/entry.cjs",
    "build": "npm run clean && npm run build:version && npm run build:renderer && npm run build:desktop && npm run build:service-test-lib && npm run build:backend && npm run check:version",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "package:dir": "electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.workspace.local",
    "productName": "Workspace",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
