{"type":"eval","expression":"[...document.querySelectorAll('.workspace-tab-scroll [role=tab]')].filter(e=>e.getAttribute('data-state')==='active').map(e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e,'::after');return {name:e.getAttribute('aria-label'),rect:{x:r.x,y:r.y,w:r.width,h:r.height},after:{content:s.content,display:s.display,position:s.position,bottom:s.bottom,height:s.height,background:s.backgroundColor,zIndex:s.zIndex,opacity:s.opacity,visibility:s.visibility,left:s.left,right:s.right,width:s.width},ancestor:e.parentElement?.outerHTML.slice(0,150)}})"}
