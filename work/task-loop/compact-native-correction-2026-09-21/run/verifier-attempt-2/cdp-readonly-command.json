{"type": "eval", "expression": "(() => ({viewport:{width:innerWidth,height:innerHeight,dpr:devicePixelRatio},url:location.href,selected:[...document.querySelectorAll('[aria-selected=\"true\"]')].map(e=>({text:e.textContent,role:e.getAttribute('role')})),buttons:[...document.querySelectorAll('button')].map(e=>e.getAttribute('aria-label')||e.getAttribute('title')||e.textContent.trim()).filter(x=>/Add View|Customize|Board|Table|Settings|Close|Restore/.test(x)).slice(0,30),hscroll:[...document.querySelectorAll('*')].filter(e=>e.scrollWidth>e.clientWidth+20&&getComputedStyle(e).overflowX.match(/auto|scroll/)).slice(0,8).map(e=>({class:e.className,client:e.clientWidth,scroll:e.scrollWidth}))}))()"}