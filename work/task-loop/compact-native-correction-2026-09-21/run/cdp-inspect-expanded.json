{"type":"eval","expression":"({tabs:[...document.querySelectorAll('[role=tab]')].map(e=>({name:e.getAttribute('aria-label'),selected:e.getAttribute('aria-selected')})),buttons:[...document.querySelectorAll('button')].map(e=>({name:e.getAttribute('aria-label')||e.textContent.trim(),title:e.getAttribute('title')})).filter(x=>x.name).slice(0,40),dialog:!!document.querySelector('[role=dialog]')})"}
