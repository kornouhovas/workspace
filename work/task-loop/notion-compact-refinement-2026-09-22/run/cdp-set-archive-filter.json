{
  "type": "eval",
  "expression": "(async()=>{const pause=(ms)=>new Promise(r=>setTimeout(r,ms));const search=[...document.querySelectorAll('input')].find(el=>(el.getAttribute('placeholder')||'').includes('Название проекта'));const setter=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;setter.call(search,'Archive 01');search.dispatchEvent(new Event('input',{bubbles:true}));await pause(400);return {query:search.value,counts:[...document.querySelectorAll('[data-workspace-column-count]')].map(el=>el.textContent?.trim()),cards:[...document.querySelectorAll('.workspace-board-column')].map(el=>el.querySelectorAll('.workspace-board-card').length)};})()"
}
