    "process_version": "task-loop-v1-tabs-visible",
    "goal": "Implement chosen Compact №3 design across Workspace renderer with a single upper toolbar, preserve all existing actions/data, verify the 56-case edge matrix at 1440x960 and 1024x720, and deliver reviewed local commit and evidence.",
    "hypothesis": "Scoped semantic palette and layout changes in existing renderer components can produce the compact design while retaining current handlers, service contracts, tab lifecycle, persistence, keyboard access and project data.",
    "scope": "Renderer UI components/styles and corresponding UI documentation and focused tests; isolated temporary fixtures only. No storage, IPC, Electron security, project identity/status rules, backend or live user files.",
    "constraints": "No invented actions from illustrations; no push/merge/release. Independent verifier checks frozen attempt before completion. Explicit unverified reason and next step for any matrix row not executable.",
    "max_attempts": 6,
    "checks": [
      {
        "id": "renderer-quality",
        "role": "quality",
        "method": "observation",
        "description": "Relevant Node tests, npm run typecheck, npm run build:renderer and git diff --check pass on changed version; failure of any command falsifies."
      },
      {
        "id": "function-parity",
        "role": "quality",
        "method": "observation",
        "description": "Existing source-backed actions, tab lifecycle, property editors/settings and renderer-only boundary remain reachable without changed storage/IPC/security/project IDs/status; any lost handler, data regression or invented action falsifies."
      },
      {
        "id": "compact-ui",
        "role": "outcome",
        "method": "observation",
        "description": "At 1440x960 and 1024x720 UI uses one upper row with textual horizontally scrollable view/project tabs and pinned actions; Add View/Customize icons lack labels/hover backdrop while retaining tooltip, accessible names and visible focus; any clipped required action, second toolbar row or inaccessible tab falsifies."
      },
      {
        "id": "edge-matrix",
        "role": "outcome",
        "method": "observation",
        "description": "All 56 matrix IDs have actual result or specific unverified reason and next step, covering long names/overflow, empty/error, editors, keyboard and measured contrast; missing row or unsupported pass claim falsifies."
      },
      {
        "id": "delivery",
        "role": "delivery",
        "method": "observation",
        "description": "Changed UI and docs are reviewable via local commit and report with screenshot paths, checks, limitations and commit hash; unavailable artifact, uncommitted intended change or missing review evidence falsifies."
      }
    ]
  },
